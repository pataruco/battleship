# Local development settings. `just setup` copies this file to .env.
# Vite reads .env when it starts and gives the VITE_* values to the app.
# These values match the local NATS server in infra/nats/. They are not secrets.
# Production does not use this file: the deploy workflow sets its own values
# (see infra/nats/README.md).

# Where the app finds NATS. Local NATS takes WebSocket connections on port 9222.
VITE_NATS_URL=ws://localhost:9222

# How the app signs in: none, userpass or creds. Local NATS uses a name and password.
VITE_NATS_AUTH=userpass
VITE_NATS_USER=browser
VITE_NATS_PASS=browser-dev

# The NATS key-value bucket that holds the games.
VITE_KV_BUCKET=bship_games
