{
  "name": "battleship",
  "version": "1.0.0",
  "description": "Kids two-player sea-battle PWA",
  "scripts": {
    "test": "npm run wasm && vitest run --project unit",
    "dev": "vite",
    "wasm": "node scripts/build-wasm.mjs",
    "test:rust": "cargo test --manifest-path engine/Cargo.toml",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "e2e": "playwright test",
    "test:int": "vitest run --project integration",
    "typecheck": "tsc --noEmit",
    "nats:up": "docker compose -f infra/nats/docker-compose.yml up -d && bash infra/nats/wait.sh && bash infra/nats/provision.sh",
    "nats:down": "docker compose -f infra/nats/docker-compose.yml down"
  },
  "keywords": [],
  "type": "module",
  "private": true,
  "devDependencies": {
    "@nats-io/jetstream": "npm:@jsr/nats-io__jetstream@3.4.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "lightningcss": "^1.33.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@nats-io/kv": "npm:@jsr/nats-io__kv@3.4.0",
    "@nats-io/nats-core": "npm:@jsr/nats-io__nats-core@3.4.0"
  }
}
